{
  "name": "lets-go",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:web:m4": "node scripts/verify-web-m4.mjs",
    "verify:web:m5": "node scripts/verify-web-m5.mjs",
    "verify:web:m5c": "node scripts/verify-web-m5c.mjs",
    "verify:web:m5d": "node scripts/verify-web-m5d.mjs",
    "verify:web:m5e": "node scripts/verify-web-m5e.mjs",
    "verify:web:m6": "node scripts/verify-web-m6.mjs",
    "verify:web:m6c": "node scripts/verify-web-m6c.mjs",
    "verify:web:m6s": "node e2e/verify-web-m6-settings.mjs",
    "verify:web:m6b": "node e2e/verify-web-m6b-13x13.mjs",
    "tune:bot": "jest --config jest.tuning.config.js",
