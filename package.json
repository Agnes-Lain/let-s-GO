    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3"
